<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x86</Platform>
    <PlatformTarget>x86</PlatformTarget>
    <OutputType>Exe</OutputType>
    <AssemblyName>LicenceRental.Tests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>$(BuildBin)\</OutputPath>
    <DefineConstants Condition="'$(Interactive)' == 'true'">$(DefineConstants);INTERACTIVE</DefineConstants>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.Entity" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="BarakalAlkheir">
      <HintPath>$(BuildBin)\BarakalAlkheir.exe</HintPath><Private>False</Private>
    </Reference>
    <Reference Include="Telerik.WinControls;Telerik.WinControls.UI;Telerik.WinControls.GridView;TelerikCommon">
      <HintPath>$(BuildBin)\%(Identity).dll</HintPath><Private>False</Private>
    </Reference>
    <Reference Include="Telerik.Licensing.Runtime">
      <HintPath>..\packages\Telerik.Licensing.1.9.1\lib\net462\Telerik.Licensing.Runtime.dll</HintPath>
    </Reference>
    <Compile Include="LicenceRental.Tests.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- The QA executable must embed its own evidence through the supported licensing task. -->
  <Import Project="..\packages\Telerik.Licensing.1.9.1\build\Telerik.Licensing.targets" />
  <Target Name="RequireApplicationBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BuildBin)' == '' Or !Exists('$(BuildBin)\BarakalAlkheir.exe')" Text="Build the application first and supply BuildBin through Run-LicenceRentalTests.ps1." />
  </Target>
</Project>
